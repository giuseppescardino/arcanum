# Public hostname of the sync server (DNS must point here).
ARCANUM_DOMAIN=sync.example.com
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# age public key used to encrypt the daily backups. Generate the key pair with
#   docker compose run --rm -T backup age-keygen > arcanum-backup-key.txt
# copy the "public key: age1..." line here and keep the file with the private
# key away from the server and the backups: without it you cannot restore.
BACKUP_AGE_RECIPIENT=age1...

# Who can create an account:
#   invite  only with a single-use code (default), created with
#             docker compose exec server arcanum-server invite create --label "Name"
#   open    anyone (public instances: bounded by quotas and per-IP limits)
#   closed  nobody
ARCANUM_REGISTRATION=invite
# Maximum items (deleted ones included) per account.
#ARCANUM_MAX_ITEMS_PER_ACCOUNT=20000

# Backup folder (default: ./backups, i.e. deploy/backups). It must be an
# absolute path: Compose does not expand ~. Examples:
#BACKUP_DIR=/Users/<user>/Library/CloudStorage/Dropbox/Arcanum-backup
#BACKUP_DIR=/Users/<user>/Library/CloudStorage/GoogleDrive-<email>/My Drive/Arcanum-backup
#BACKUP_DIR=/Users/<user>/Library/Mobile Documents/com~apple~CloudDocs/Arcanum-backup
#BACKUP_DIR=/mnt/nas/Arcanum-backup
